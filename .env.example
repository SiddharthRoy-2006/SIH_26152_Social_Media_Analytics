# Data modes: "empty" (honest zero state), "demo" (rich simulation), "live" (real platform APIs)
SOCIALIQ_DATA_MODE=demo

# Comma-separated local frontend origins allowed by CORS.
SOCIALIQ_CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:5501,http://localhost:5501

# --- Platform API Credentials (optional: used when SOCIALIQ_DATA_MODE=live) ---
# YouTube Data API v3 (Google Cloud API Key)
# YOUTUBE_API_KEY=AIzaSy...

# Google OAuth 2.0 (YouTube Analytics & User Consent)
# GOOGLE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your_client_secret_here
# GOOGLE_REDIRECT_URI=http://127.0.0.1:8001/api/auth/callback

# Telegram MTProto (my.telegram.org)
# TELEGRAM_API_ID=12345678
# TELEGRAM_API_HASH=abcdef0123456789...

# Reddit API (reddit.com/prefs/apps)
# REDDIT_CLIENT_ID=client_id_here
# REDDIT_CLIENT_SECRET=client_secret_here

# Twitter / X API v2 (developer.x.com)
# TWITTER_BEARER_TOKEN=AAAAAAAAAAAAAAAAAAAA...

# --- Supabase PostgreSQL Persistence (Historical Data & Sync) ---
# Direct connection (if IPv6 supported) or Session Pooler (port 5432) for IPv4:
# SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.rsajzglrfvuojdiditqu.supabase.co:5432/postgres
# Or using Session Pooler:
# SUPABASE_DB_URL=postgresql://postgres.rsajzglrfvuojdiditqu:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Alternatively, individual parameters:
# SUPABASE_HOST=aws-0-ap-south-1.pooler.supabase.com
# SUPABASE_PORT=5432
# SUPABASE_DATABASE=postgres
# SUPABASE_USER=postgres.rsajzglrfvuojdiditqu
# SUPABASE_PASSWORD=your_database_password_here

# Storage limits (in MB)
# DATABASE_STORAGE_SOFT_LIMIT_MB=400.0
# DATABASE_STORAGE_CRITICAL_LIMIT_MB=480.0

# --- Blockchain Audit & Integrity Layer (SIH 26152) ---
# Local EVM RPC URL (e.g. Hardhat node or Anvil)
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CHAIN_ID=31337
BLOCKCHAIN_NETWORK_NAME=Local EVM (Hardhat Node)
# Deployed contract address on chosen EVM network (set after running python -m backend.blockchain.deploy)
BLOCKCHAIN_CONTRACT_ADDRESS=
# Development/demo private key (NEVER use production keys; server-side signing only)
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_ACCOUNT_ADDRESS=
BLOCKCHAIN_ENABLED=true


