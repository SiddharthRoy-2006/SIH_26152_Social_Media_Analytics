# Default is "empty": responses use the frontend's honest zero/no-information state.
SOCIALIQ_DATA_MODE=empty

# Use only for local UI development; demo data is clearly marked with source="demo".
# SOCIALIQ_DATA_MODE=demo

# Comma-separated local frontend origins allowed by CORS.
SOCIALIQ_CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
